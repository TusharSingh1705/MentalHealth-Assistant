# ============================================
# MentalHealth Assistant — Environment Configuration
# ============================================

# ---------- MongoDB ----------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mentalhealth

# ---------- JWT ----------
JWT_SECRET=your-secret-jwt-key
JWT_EXPIRES_IN=7d

# ---------- Session ----------
SESSION_SECRET=your-session-secret-key

# ---------- Gemini API (Optional) ----------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Python RAG ----------
PYTHON_PATH=python
RAG_SCRIPT_PATH=./rag/pipeline.py
CHROMA_DB_PATH=./rag/chroma_db
